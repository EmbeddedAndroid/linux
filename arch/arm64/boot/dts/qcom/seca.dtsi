		tlmm: pinctrl@f100000 {
			compatible = "qcom,seca-tlmm", "qcom,nord-tlmm";
			reg = <0x0 0x0f100000 0x0 0xc0000>;
			interrupts = <GIC_SPI 208 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
			gpio-ranges = <&tlmm 0 0 181>;

			qup_i2c18_default: qup-i2c18-default-state {
				pins = "gpio154", "gpio155";
				function = "qup2_se4";
				drive-strength = <2>;
				bias-pull-up;
			};

			qup_spi16_default: qup-spi16-default-state {
				pins = "gpio145", "gpio146", "gpio147", "gpio148";
				function = "qup2_se2";
				drive-strength = <6>;
				bias-disable;
			};

			qup_uart15_default: qup-uart15-default-state {
				pins = "gpio143", "gpio144";
				function = "qup2_se1";
				drive-strength = <2>;
				bias-disable;
			};
		};

