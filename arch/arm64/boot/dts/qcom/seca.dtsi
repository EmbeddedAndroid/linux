				     <GIC_ESPI 242 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_ESPI 243 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_ESPI 244 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_ESPI 245 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_ESPI 246 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_ESPI 247 IRQ_TYPE_LEVEL_HIGH>,
