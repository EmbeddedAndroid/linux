		pins = "gpio129", "gpio130";
		function = "qup1_se3";
		drive-strength = <2>;
		bias-disable;
	};

	qup_uart11_default: qup-uart11-default-state {
		pins = "gpio137", "gpio138";
		function = "qup1_se4";
		drive-strength = <2>;
		bias-disable;
	};

	qup_uart12_default: qup-uart12-default-state {
		pins = "gpio135", "gpio136";
		function = "qup1_se5";
		drive-strength = <2>;
		bias-disable;
	};

	qup_uart13_default: qup-uart13-default-state {
		pins = "gpio131", "gpio132";
		function = "qup1_se6";
		drive-strength = <2>;
		bias-disable;
	};

	qup_uart14_default: qup-uart14-default-state {
		pins = "gpio141", "gpio142";
		function = "qup2_se0";
		drive-strength = <2>;
		bias-disable;
	};

	qup_uart15_default: qup-uart15-default-state {
		pins = "gpio143", "gpio144";
		function = "qup2_se1";
		drive-strength = <2>;
		bias-disable;
	};

	qup_uart16_default: qup-uart16-default-state {
		pins = "gpio147", "gpio148";
		function = "qup2_se2";
		drive-strength = <2>;
		bias-disable;
	};

	qup_uart17_default: qup-uart17-default-state {
		pins = "gpio152", "gpio153";
		function = "qup2_se3";
		drive-strength = <2>;
		bias-disable;
	};

	qup_uart18_default: qup-uart18-default-state {
		pins = "gpio143", "gpio144";
		function = "qup2_se4";
		drive-strength = <2>;
		bias-disable;
	};

	qup_uart19_default: qup-uart19-default-state {
		pins = "gpio158", "gpio159";
		function = "qup2_se5";
		drive-strength = <2>;
		bias-disable;
	};

	qup_uart20_default: qup-uart20-default-state {
		pins = "gpio156", "gpio157";
		function = "qup2_se6";
		drive-strength = <2>;
		bias-disable;
	};

	/*
	 * DisplayPort hot-plug-detect pads.  The msm DP driver does HPD
	 * with the controller's internal HPD register block plus its own
	 * platform IRQ; it consumes no hpd-gpios and binds no pinctrl
	 * itself.  These states only mux the TLMM pad to the SoC HPD
	 * function so the internal HPD block sees the sink edge - the
	 * driver-core "default" pinctrl applies them at probe.  Mapping
	 * from the Nord XBL pinctrl.dtsi:
	 *   DP2 (af64000) HPD = GPIO51 func edp0_hot (downstream eDP0)
	 *   DP3 (af6c000) HPD = GPIO52 func edp1_hot (downstream eDP1)
	 */
	dp2_hpd_default: dp2-hpd-default-state {
		pins = "gpio51";
		function = "edp0_hot";
		bias-disable;
	};

	dp3_hpd_default: dp3-hpd-default-state {
		pins = "gpio52";
		function = "edp1_hot";
		bias-disable;
	};
};

&uart0 {
	clocks = <&negcc SE_GCC_QUPV3_WRAP0_S0_CLK>;
	clock-names = "se";
	interconnects = <&clk_virt MASTER_QUP_CORE_0 QCOM_ICC_TAG_ALWAYS
			 &clk_virt SLAVE_QUP_CORE_0 QCOM_ICC_TAG_ALWAYS>,
			<&hscnoc MASTER_APPSS_PROC QCOM_ICC_TAG_ALWAYS
			 &config_noc SLAVE_QUP_0 QCOM_ICC_TAG_ALWAYS>;
	interconnect-names = "qup-core", "qup-config";
	pinctrl-0 = <&qup_uart0_default>;
	pinctrl-names = "default";
};

