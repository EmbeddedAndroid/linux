};

&uart15 {
	status = "okay";
};

&ufs_mem_hc {
	reset-gpios = <&tlmm 181 GPIO_ACTIVE_LOW>;

	vcc-supply = <&vreg_l3i_2p5>;
	vcc-max-microamp = <1300000>;
	vccq-supply = <&vreg_l2i_1p2>;
	vccq-max-microamp = <1200000>;
	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l1i_0p9>;
	vdda-pll-supply = <&vreg_l2h_1p2>;
	status = "okay";
};

/* === IQ-10 EVK i2c/spi enablement (sensor discovery + spidev) === */
&i2c19 { clock-frequency = <400000>; status = "okay"; };   /* IPCAT: SENSOR & power-monitor I2C (gpio156/157) */
&i2c9  { clock-frequency = <400000>; status = "okay"; };   /* IPCAT: USB-PD/eUSB repeater & SMBus (gpio127/128) */
&i2c7  { clock-frequency = <100000>; status = "okay"; };   /* DP1 DDC/AUX (gpio123/124) */
&i2c12 { clock-frequency = <100000>; status = "okay"; };   /* DP0 DDC/AUX (gpio133-136) */

&spi16 {                                                   /* qup0_se2, gpio145/146/147/148 */
	status = "okay";
	spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <10000000>;
	};
};

/* GENI QUP serial-engine firmware (geni_load_se_firmware reads firmware-name from the wrapper) */
&qupv3_0 { firmware-name = "qcom/sa8797p/qupv3fw.elf"; };
&qupv3_1 { firmware-name = "qcom/sa8797p/qupv3fw.elf"; };
&qupv3_2 { firmware-name = "qcom/sa8797p/qupv3fw.elf"; };

/* enable the display subsystem for first-light (DPU + DP2/DP3 outputs + DP2/DP3 PHYs) */
&mdss          { status = "okay"; };
&mdss_mdp      { status = "okay"; };
&mdss_dp2 {
	/* HPD pad: GPIO51 func edp0_hot (downstream eDP0 -> DP2) */
	pinctrl-0 = <&dp2_hpd_default>;
	pinctrl-names = "default";
	status = "okay";
};
&mdss_dp2_phy  { status = "okay"; };
&mdss_dp3 {
	/* HPD pad: GPIO52 func edp1_hot (downstream eDP1 -> DP3) */
	pinctrl-0 = <&dp3_hpd_default>;
	pinctrl-names = "default";
	status = "okay";
};
&mdss_dp3_phy  { status = "okay"; };

/* Disable the GPU/GMU so the msm DRM aggregate (DPU + DP) can complete and
 * register /dev/dri/card0.  The GPU (adreno) is bound as a component of the
 * same DRM device; its bind was failing -19 (stuck behind the GMU CM3 init)
 * and taking the whole DRM device down.  GPU/GMU bring-up tracked separately. */
&gpu { status = "disabled"; };
&gmu { status = "disabled"; };

/* DPU MDSS IOMMU on the mdss wrapper (the DPU child inherits it).  SID 0x3e0
 * block on apps_smmu_1 (TCU1); mask 0x20000 covers the pixel/config tag (0x203e0).
 * Source: downstream TZ IORT DISPLAY_0 node (nord.c). Without this the DPU KMS
 * init fails "no IOMMU, bailing out" -> -19 (and oopses in the failure unwind). */
&mdss { iommus = <&apps_smmu_1 0x3e0 0x20000>; };

/* Disable the pdp_scmi arm,scmi transport.  Its arm-scmi platform device
 * fails to set up the BASE protocol channel (protocol 0x10) and then
 * retries via deferred probe indefinitely, flooding the log.  Its only
 * protocol, cpu_perf (0x13), has no consumer in the device tree, so
 * disabling the node loses no functionality and silences the boot. */
&pdp_scmi { status = "disabled"; };
