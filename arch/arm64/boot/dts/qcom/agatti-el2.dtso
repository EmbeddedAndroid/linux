/dts-v1/;
/plugin/;

&remoteproc_adsp {
	iommus = <&apps_smmu 0x1c0 0x0>;
};

&gpu_zap_shader {
	iommus = <&adreno_smmu 0x3 0x0>;
};

&venus {
	video-firmware {
		iommus = <&apps_smmu 0x882 0x0>;
	};
};
