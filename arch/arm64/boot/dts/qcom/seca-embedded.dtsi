#include <dt-bindings/clock/qcom,nord-tcsrcc.h>
#include <dt-bindings/clock/qcom,rpmh.h>
#include <dt-bindings/clock/qcom,seca-negcc.h>
#include <dt-bindings/clock/qcom,seca-nwgcc.h>
#include <dt-bindings/interconnect/qcom,icc.h>
#include <dt-bindings/interconnect/qcom,seca-rpmh.h>
#include <dt-bindings/power/qcom,rpmhpd.h>
#include <dt-bindings/soc/qcom,rpmh-rsc.h>

#include "seca.dtsi"

/ {
	clk_virt: interconnect-0 {
		compatible = "qcom,seca-clk-virt";
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
	};

	mc_virt: interconnect-1 {
		compatible = "qcom,seca-mc-virt";
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
	};
};

&i2c18 {
	clocks = <&negcc NE_GCC_QUPV3_WRAP2_S4_CLK>;
	clock-names = "se";

	interconnects = <&clk_virt MASTER_QUP_CORE_2 QCOM_ICC_TAG_ALWAYS
			 &clk_virt SLAVE_QUP_CORE_2 QCOM_ICC_TAG_ALWAYS>,
			<&hscnoc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
			 &cnoc_cfg SLAVE_QUP_2 QCOM_ICC_TAG_ACTIVE_ONLY>,
			<&aggre1_noc MASTER_QUP_2 QCOM_ICC_TAG_ALWAYS
			 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
	interconnect-names = "qup-core",
			     "qup-config",
			     "qup-memory";

	pinctrl-0 = <&qup_i2c18_default>;
	pinctrl-names = "default";
};

&qupv3_2 {
	clocks = <&negcc NE_GCC_QUPV3_WRAP2_M_AHB_CLK>,
		 <&negcc NE_GCC_QUPV3_WRAP2_S_AHB_CLK>;
	clock-names = "m-ahb",
		      "s-ahb";

	interconnects = <&clk_virt MASTER_QUP_CORE_2 QCOM_ICC_TAG_ALWAYS
			 &clk_virt SLAVE_QUP_CORE_2 QCOM_ICC_TAG_ALWAYS>;
	interconnect-names = "qup-core";

	iommus = <&apps_smmu_0 0x12a0 0x0>;
};

&remoteproc_adsp {
	clocks = <&rpmhcc RPMH_CXO_CLK>;
	clock-names = "xo";

	interconnects = <&hpass_ag_noc MASTER_HPASS_PROC_0 QCOM_ICC_TAG_ALWAYS
			 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;

	power-domains = <&rpmhpd RPMHPD_CX>,
			<&rpmhpd RPMHPD_MX>;
	power-domain-names = "cx",
			     "mx";

	iommus = <&apps_smmu_2 0x9e0 0x0>;
};

&remoteproc_cdsp0 {
	clocks = <&rpmhcc RPMH_CXO_CLK>;
	clock-names = "xo";

	interconnects = <&nsp_data_noc_0 MASTER_NSP0_PROC QCOM_ICC_TAG_ALWAYS
			 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;

	power-domains = <&rpmhpd RPMHPD_CX>,
			<&rpmhpd RPMHPD_NMXC>,
			<&rpmhpd RPMHPD_NSP0>;
	power-domain-names = "cx",
			     "mx",
			     "nsp";

	iommus = <&apps_smmu_2 0x360 0x0>;
};

&remoteproc_cdsp1 {
	clocks = <&rpmhcc RPMH_CXO_CLK>;
	clock-names = "xo";

	interconnects = <&nsp_data_noc_1 MASTER_NSP1_PROC QCOM_ICC_TAG_ALWAYS
			 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;

	power-domains = <&rpmhpd RPMHPD_CX>,
			<&rpmhpd RPMHPD_NMXC>,
			<&rpmhpd RPMHPD_NSP1>;
	power-domain-names = "cx",
			     "mx",
			     "nsp";

	iommus = <&apps_smmu_2 0x760 0x0>;
};

&soc {
	cnoc_main: interconnect@1500000 {
		compatible = "qcom,seca-cnoc-main";
		reg = <0x0 0x01500000 0x0 0x1d200>;
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
	};

	cnoc_cfg: interconnect@1600000 {
		compatible = "qcom,seca-cnoc-cfg";
		reg = <0x0 0x01600000 0x0 0xb200>;
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
	};

	system_noc: interconnect@1680000 {
		compatible = "qcom,seca-system-noc";
		reg = <0x0 0x01680000 0x0 0x1b080>;
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
	};

	aggre2_noc_tile: interconnect@16c0000 {
		compatible = "qcom,seca-aggre2-noc-tile";
		reg = <0x0 0x016c0000 0x0 0x1b400>;
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
	};

	aggre1_noc: interconnect@16e0000 {
		compatible = "qcom,seca-aggre1-noc";
		reg = <0x0 0x016e0000 0x0 0x1d400>;
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
		clocks = <&negcc NE_GCC_AGGRE_NOC_USB2_AXI_CLK>,
			 <&negcc NE_GCC_AGGRE_NOC_USB3_PRIM_AXI_CLK>,
			 <&negcc NE_GCC_AGGRE_NOC_USB3_SEC_AXI_CLK>;
	};

	aggre2_noc: interconnect@1700000 {
		compatible = "qcom,seca-aggre2-noc";
		reg = <0x0 0x01700000 0x0 0x1b400>;
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
		clocks = <&rpmhcc RPMH_IPA_CLK>;
	};

	aggre1_noc_tile: interconnect@1720000 {
		compatible = "qcom,seca-aggre1-noc-tile";
		reg = <0x0 0x01720000 0x0 0x23400>;
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
		clocks = <&nwgcc NW_GCC_AGGRE_NOC_UFS_0_PHY_AXI_CLK>,
			 <&nwgcc NW_GCC_AGGRE_NOC_UFS_1_PHY_AXI_CLK>;
	};

	mmss_noc_sf: interconnect@1780000 {
		compatible = "qcom,seca-mmss-noc-sf";
		reg = <0x0 0x01780000 0x0 0x40000>;
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
	};

	mmss_noc_hf: interconnect@17c0000 {
		compatible = "qcom,seca-mmss-noc-hf";
		reg = <0x0 0x017c0000 0x0 0x2e400>;
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
	};

	pcie_cfg: interconnect@1ba0000 {
		compatible = "qcom,seca-pcie-cfg";
		reg = <0x0 0x01ba0000 0x0 0x7200>;
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
	};

	pcie_data_outbound: interconnect@1bc0000 {
		compatible = "qcom,seca-pcie-data-outbound";
		reg = <0x0 0x01bc0000 0x0 0x17000>;
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
	};

	pcie_data_inbound: interconnect@1c00000 {
		compatible = "qcom,seca-pcie-data-inbound";
		reg = <0x0 0x01c00000 0x0 0x50080>;
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
	};

	ufs_mem_phy: phy@1d40000 {
		compatible = "qcom,seca-qmp-ufs-phy",
			     "qcom,sm8650-qmp-ufs-phy";
		reg = <0x0 0x01d40000 0x0 0x2000>;

		clocks = <&rpmhcc RPMH_CXO_CLK>,
			 <&nwgcc NW_GCC_UFS_0_PHY_PHY_AUX_CLK>,
			 <&tcsrcc TCSR_UFS_CLKREF_EN>;
		clock-names = "ref",
			      "ref_aux",
			      "qref";

		resets = <&ufs_mem_hc 0>;
		reset-names = "ufsphy";

		power-domains = <&nwgcc NW_GCC_UFS_0_MEM_PHY_GDSC>;

		#clock-cells = <1>;
		#phy-cells = <0>;

		status = "disabled";
	};

	hscnoc: interconnect@2000000 {
		compatible = "qcom,seca-hscnoc";
		reg = <0x0 0x02000000 0x0 0xb2d080>;
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
	};

	hpass_ag_noc: interconnect@5fc0000 {
		compatible = "qcom,seca-hpass-ag-noc";
		reg = <0x0 0x05fc0000 0x0 0x37080>;
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
	};

	usb_0_hsphy: phy@88ea000 {
		compatible = "qcom,seca-snps-eusb2-phy",
			     "qcom,sm8550-snps-eusb2-phy";
		reg = <0x0 0x088ea000 0x0 0x154>;
		#phy-cells = <0>;

		clocks = <&tcsrcc TCSR_USB2_0_CLKREF_EN>;
		clock-names = "ref";

		resets = <&negcc NE_GCC_QUSB2PHY_PRIM_BCR>;

		status = "disabled";
	};

	negcc: clock-controller@8900000 {
		compatible = "qcom,seca-negcc";
		reg = <0x0 0x08900000 0x0 0xf4200>;
		clocks = <&bi_tcxo_div2>,
			 <&sleep_clk>,
			 <0>,
			 <0>;
		power-domains = <&rpmhpd RPMHPD_CX>;
		#clock-cells = <1>;
		#reset-cells = <1>;
		#power-domain-cells = <1>;
	};

	nwgcc: clock-controller@8b00000 {
		compatible = "qcom,seca-nwgcc";
		reg = <0x0 0x08b00000 0x0 0xf4200>;
		clocks = <&bi_tcxo_div2>,
			 <&sleep_clk>,
			 <&ufs_mem_phy 0>,
			 <&ufs_mem_phy 1>,
			 <&ufs_mem_phy 2>,
			 <0>,
			 <0>,
			 <0>;
		power-domains = <&rpmhpd RPMHPD_CX>;
		#clock-cells = <1>;
		#reset-cells = <1>;
		#power-domain-cells = <1>;
	};

	tcsrcc: clock-controller@f1d9000 {
		compatible = "qcom,seca-tcsrcc",
			     "syscon";
		reg = <0x0 0x0f1d9000 0x0 0xf00c>;
		clocks = <&rpmhcc RPMH_CXO_CLK>;
		#clock-cells = <1>;
		#reset-cells = <1>;
	};

	apps_rsc: rsc@18900000 {
		compatible = "qcom,rpmh-rsc";
		reg = <0x0 0x18900000 0x0 0x10000>,
		      <0x0 0x18910000 0x0 0x10000>,
		      <0x0 0x18920000 0x0 0x10000>;
		reg-names = "drv-0",
			    "drv-1",
			    "drv-2";
		interrupts = <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 29 IRQ_TYPE_LEVEL_HIGH>;
		qcom,tcs-offset = <0xd00>;
		qcom,drv-id = <2>;
		qcom,tcs-config = <ACTIVE_TCS 3>,
				  <SLEEP_TCS 2>,
				  <WAKE_TCS 2>,
				  <CONTROL_TCS 0>;
		label = "apps_rsc";
		power-domains = <&system_pd>;

		apps_bcm_voter: bcm-voter {
			compatible = "qcom,bcm-voter";
		};

		rpmhcc: clock-controller {
			compatible = "qcom,seca-rpmh-clk",
				     "qcom,nord-rpmh-clk";
			clocks = <&xo_board>;
			clock-names = "xo";
			#clock-cells = <1>;
		};

		rpmhpd: power-controller {
			compatible = "qcom,seca-rpmhpd";
			#power-domain-cells = <1>;
			operating-points-v2 = <&rpmhpd_opp_table>;

			rpmhpd_opp_table: opp-table {
				compatible = "operating-points-v2";

				rpmhpd_opp_ret: opp-0 {
					opp-level = <RPMH_REGULATOR_LEVEL_RETENTION>;
				};

				rpmhpd_opp_min_svs: opp-1 {
					opp-level = <RPMH_REGULATOR_LEVEL_MIN_SVS>;
				};

				rpmhpd_opp_low_svs: opp-2 {
					opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS>;
				};

				rpmhpd_opp_svs: opp-3 {
					opp-level = <RPMH_REGULATOR_LEVEL_SVS>;
				};

				rpmhpd_opp_svs_l1: opp-4 {
					opp-level = <RPMH_REGULATOR_LEVEL_SVS_L1>;
				};

				rpmhpd_opp_nom: opp-5 {
					opp-level = <RPMH_REGULATOR_LEVEL_NOM>;
				};

				rpmhpd_opp_nom_l1: opp-6 {
					opp-level = <RPMH_REGULATOR_LEVEL_NOM_L1>;
				};

				rpmhpd_opp_nom_l2: opp-7 {
					opp-level = <RPMH_REGULATOR_LEVEL_NOM_L2>;
				};

				rpmhpd_opp_turbo: opp-8 {
					opp-level = <RPMH_REGULATOR_LEVEL_TURBO>;
				};

				rpmhpd_opp_turbo_l1: opp-9 {
					opp-level = <RPMH_REGULATOR_LEVEL_TURBO_L1>;
				};
			};
		};
	};

	nsp_data_noc_0: interconnect@1f200000 {
		compatible = "qcom,seca-nsp-data-noc-0";
		reg = <0x0 0x1f200000 0x0 0x2a200>;
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
	};

	nsp_data_noc_1: interconnect@1f600000 {
		compatible = "qcom,seca-nsp-data-noc-1";
		reg = <0x0 0x1f600000 0x0 0x2a200>;
		qcom,bcm-voters = <&apps_bcm_voter>;
		#interconnect-cells = <2>;
	};
};

&spi16 {
	clocks = <&negcc NE_GCC_QUPV3_WRAP2_S2_CLK>;
	clock-names = "se";

	interconnects = <&clk_virt MASTER_QUP_CORE_2 QCOM_ICC_TAG_ALWAYS
			 &clk_virt SLAVE_QUP_CORE_2 QCOM_ICC_TAG_ALWAYS>,
			<&hscnoc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
			 &cnoc_cfg SLAVE_QUP_2 QCOM_ICC_TAG_ACTIVE_ONLY>,
			<&aggre1_noc MASTER_QUP_2 QCOM_ICC_TAG_ALWAYS
			 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
	interconnect-names = "qup-core",
			     "qup-config",
			     "qup-memory";

	pinctrl-0 = <&qup_spi16_default>;
	pinctrl-names = "default";
};

&tlmm {
	qup_i2c18_default: qup-i2c18-default-state {
		pins = "gpio154", "gpio155";
		function = "qup2_se4";
		drive-strength = <2>;
		bias-pull-up;
	};

	qup_spi16_default: qup-spi16-default-state {
		pins = "gpio145", "gpio146", "gpio147", "gpio148";
		function = "qup2_se2";
		drive-strength = <6>;
		bias-disable;
	};

	qup_uart15_default: qup-uart15-default-state {
		pins = "gpio143", "gpio144";
		function = "qup2_se1";
		drive-strength = <2>;
		bias-disable;
	};
};

&uart15 {
	clocks = <&negcc NE_GCC_QUPV3_WRAP2_S1_CLK>;
	clock-names = "se";

	interconnects = <&clk_virt MASTER_QUP_CORE_2 QCOM_ICC_TAG_ALWAYS
			 &clk_virt SLAVE_QUP_CORE_2 QCOM_ICC_TAG_ALWAYS>,
			<&hscnoc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
			 &cnoc_cfg SLAVE_QUP_2 QCOM_ICC_TAG_ACTIVE_ONLY>;
	interconnect-names = "qup-core",
			     "qup-config";

	pinctrl-0 = <&qup_uart15_default>;
	pinctrl-names = "default";
};

&ufs_mem_hc {
	clocks = <&nwgcc NW_GCC_UFS_0_PHY_AXI_CLK>,
		 <&nwgcc NW_GCC_AGGRE_NOC_UFS_0_PHY_AXI_CLK>,
		 <&nwgcc NW_GCC_UFS_0_PHY_AHB_CLK>,
		 <&nwgcc NW_GCC_UFS_0_PHY_UNIPRO_CORE_CLK>,
		 <&tcsrcc TCSR_UFS_CLKREF_EN>,
		 <&nwgcc NW_GCC_UFS_0_PHY_TX_SYMBOL_0_CLK>,
		 <&nwgcc NW_GCC_UFS_0_PHY_RX_SYMBOL_0_CLK>,
		 <&nwgcc NW_GCC_UFS_0_PHY_RX_SYMBOL_1_CLK>;
	clock-names = "core_clk",
		      "bus_aggr_clk",
		      "iface_clk",
		      "core_clk_unipro",
		      "ref_clk",
		      "tx_lane0_sync_clk",
		      "rx_lane0_sync_clk",
		      "rx_lane1_sync_clk";

	interconnects = <&aggre1_noc_tile MASTER_UFS_MEM QCOM_ICC_TAG_ALWAYS
			 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
			<&hscnoc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
			 &cnoc_cfg SLAVE_UFS_MEM_CFG QCOM_ICC_TAG_ACTIVE_ONLY>;
	interconnect-names = "ufs-ddr",
			     "cpu-ufs";

	resets = <&nwgcc NW_GCC_UFS_0_PHY_BCR>;
	reset-names = "rst";

	power-domains = <&nwgcc NW_GCC_UFS_0_PHY_GDSC>;
	operating-points-v2 = <&ufs_opp_table>;
	required-opps = <&rpmhpd_opp_nom>;

	phys = <&ufs_mem_phy>;
	phy-names = "ufsphy";

	#reset-cells = <1>;

	ufs_opp_table: opp-table {
		compatible = "operating-points-v2";

		opp-201500000 {
			opp-hz = /bits/ 64 <201500000>,
				 /bits/ 64 <0>,
				 /bits/ 64 <0>,
				 /bits/ 64 <201500000>,
				 /bits/ 64 <0>,
				 /bits/ 64 <0>,
				 /bits/ 64 <0>,
				 /bits/ 64 <0>;
			required-opps = <&rpmhpd_opp_svs>;
		};

		opp-403000000 {
			opp-hz = /bits/ 64 <403000000>,
				 /bits/ 64 <0>,
				 /bits/ 64 <0>,
				 /bits/ 64 <403000000>,
				 /bits/ 64 <0>,
				 /bits/ 64 <0>,
				 /bits/ 64 <0>,
				 /bits/ 64 <0>;
			required-opps = <&rpmhpd_opp_nom>;
		};
	};
};

&usb_0 {
	clocks = <&negcc NE_GCC_CNOC_USB3_PRIM_AXI_CLK>,
		 <&negcc NE_GCC_USB31_PRIM_MASTER_CLK>,
		 <&negcc NE_GCC_AGGRE_NOC_USB3_PRIM_AXI_CLK>,
		 <&negcc NE_GCC_USB31_PRIM_SLEEP_CLK>,
		 <&negcc NE_GCC_USB31_PRIM_MOCK_UTMI_CLK>,
		 <&tcsrcc TCSR_USB3_0_CLKREF_EN>;
	clock-names = "cfg_noc",
		      "core",
		      "iface",
		      "sleep",
		      "mock_utmi",
		      "xo";
	assigned-clocks = <&negcc NE_GCC_USB31_PRIM_MOCK_UTMI_CLK>,
			  <&negcc NE_GCC_USB31_PRIM_MASTER_CLK>;
	assigned-clock-rates = <19200000>, <200000000>;

	interconnects = <&aggre1_noc MASTER_USB3_0 QCOM_ICC_TAG_ALWAYS
			 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
			<&hscnoc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
			 &cnoc_cfg SLAVE_USB3_0 QCOM_ICC_TAG_ACTIVE_ONLY>;
	interconnect-names = "usb-ddr",
			     "apps-usb";

	power-domains = <&negcc NE_GCC_USB31_PRIM_GDSC>;

	resets = <&negcc NE_GCC_USB31_PRIM_BCR>;

	phys = <&usb_0_hsphy>;
	phy-names = "usb2-phy";
};
